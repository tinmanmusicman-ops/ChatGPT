<Window x:Class="PainRadar.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to GearRadar"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#000000"
        Foreground="#E5E7EB"
        FontSize="{Binding UiFontSize}">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#0B1220"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="Text" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Link" Color="#14B8A6"/>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F2937"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="GearRadar" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Scan Reddit and Craigslist wanted listings for buyer intent on specific music gear. Matches show up in the table and are appended to a CSV log."/>
                    <TextBlock Foreground="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Tip: keep “Require intent + gear” enabled to only show strong matches."/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="What to do" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="1) Click into the Search box (we’ll focus it for you when you close this) and optionally type a keyword to narrow results."/>
                            <TextBlock Text="2) Choose sources (Reddit and/or Craigslist)." Margin="0,6,0,0"/>
                            <TextBlock Text="3) Click Scan. Watch the status bar for progress (sources can be temporarily unavailable)." Margin="0,6,0,0"/>
                            <TextBlock Text="4) Sort by Score and click a row to see intent phrases, matched gear, and source links on the right." Margin="0,6,0,0"/>
                            <TextBlock Text="5) Click the Title hyperlink to open the post/listing in your browser." Margin="0,6,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Optional search examples" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>
                        <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                            <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Gear Models" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="s88, seaboard, apc40, ewi, axiom"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Intent Phrases" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="wtb, looking for, anyone selling, want to buy"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Gear Categories" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="classical guitar, nylon string, MIDI controller"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Platforms" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="reddit, craigslist, wanted, wtb"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Regions" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="nyc, la, bay area (depends on Craigslist site list)"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Hints" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="increase Min Total to reduce noise"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Tips" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8"/>
                        <TextBlock Foreground="{StaticResource MutedText}" Text="If you get too many results, increase Min Total. If you get none, set Min Total to 0 and scan again. Higher Score generally indicates clearer buyer-intent + gear match."/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Got it — focus Search" Width="190" IsDefault="True" Click="GotIt_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
