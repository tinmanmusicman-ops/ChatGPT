<Window x:Class="PainRadar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GearRadar" Height="820" Width="1280" MinHeight="720" MinWidth="1100"
        Background="#000000" Foreground="#E5E7EB"
        FontSize="{Binding UiFontSize}">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="PanelBg" Color="#0B1220"/>
        <SolidColorBrush x:Key="ControlBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="Text" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Link" Color="#14B8A6"/>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="#1D4ED8"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F2937"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Hyperlink}">
            <Setter Property="Foreground" Value="{StaticResource Link}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style x:Key="DarkColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="DarkCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="RowBackground" Value="{StaticResource Bg}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelBg}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Border}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkColumnHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource DarkCell}"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#111827"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F2937"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type StatusBar}">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="PainRadar" Foreground="White" FontSize="{Binding UiFontSizeXl}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Search" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchTextBox" Width="210" Height="72"
                                 FontSize="{Binding UiFontSizeLg}" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="2" Content="Scan" Width="110" Height="36" Margin="0,0,8,0"
                                Command="{Binding ScanCommand}"
                                Background="#2563EB" BorderBrush="#1D4ED8" Foreground="White" FontWeight="SemiBold"/>
                        <Button Grid.Column="3" Content="Cancel" Width="110" Height="36"
                                Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="4" Content="Reset" Width="92" Height="36" Margin="8,0,0,0"
                                Command="{Binding ResetFiltersCommand}"/>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0" ItemHeight="28">
                        <TextBlock Text="Min Total" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Width="180" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                Value="{Binding MinTotalScore, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding MinTotalScore, StringFormat={}{0:0}}" Foreground="#D1D5DB" Width="40" VerticalAlignment="Center" Margin="0,0,18,0"/>

                        <TextBlock Text="Font" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Width="140" Minimum="10" Maximum="24" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding UiFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding UiFontSize, StringFormat={}{0:0}}" Foreground="#D1D5DB" Width="34" VerticalAlignment="Center" Margin="0,0,18,0"/>

                        <TextBlock Text="{Binding VisibleResults}" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                        <TextBlock Text="/" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{Binding TotalResults}" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FilterSummary, StringFormat={}  ({0})}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,18,0"/>

                        <CheckBox Content="Reddit" Foreground="#E5E7EB" IsChecked="{Binding EnableReddit}" Margin="0,0,14,0"/>
                        <CheckBox Content="Craigslist" Foreground="#E5E7EB" IsChecked="{Binding EnableCraigslist}" Margin="0,0,14,0"/>
                        <CheckBox Content="Require intent + gear" Foreground="#E5E7EB" IsChecked="{Binding RequireIntentAndGearMatch}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding ModeLabel}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                     </WrapPanel>
                 </Grid>
             </DockPanel>
         </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Score" Binding="{Binding TotalScore, Mode=OneWay}" SortMemberPath="TotalScore" Width="74"/>
                        <DataGridTextColumn Header="Platform" Binding="{Binding Platform, Mode=OneWay}" SortMemberPath="Platform" Width="96"/>
                        <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer, Mode=OneWay}" SortMemberPath="Buyer" Width="140"/>
                        <DataGridTextColumn Header="Gear" Binding="{Binding MatchedGearDisplay, Mode=OneWay}" SortMemberPath="MatchedGearDisplay" Width="220"/>
                        <DataGridTemplateColumn Header="Title" SortMemberPath="Title" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding Url}">
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="When" Binding="{Binding PostedAtDisplay, Mode=OneWay}" SortMemberPath="PostedAtDisplay" Width="140"/>
                        <DataGridTextColumn Header="Intent" Binding="{Binding IntentScore, Mode=OneWay}" SortMemberPath="IntentScore" Width="74"/>
                        <DataGridTextColumn Header="GearScore" Binding="{Binding GearScore, Mode=OneWay}" SortMemberPath="GearScore" Width="88"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18" CornerRadius="12"
                        Background="#0B1220" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalResults}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Width="520">
                        <TextBlock Text="No results yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Type a search term (optional) then click Scan (or press Enter)."
                                   Foreground="{StaticResource MutedText}" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="If you already scanned and still see nothing, click Reset and set Min Total to 0."
                                   Foreground="{StaticResource MutedText}" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#111827"/>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedItem.MatchedGearDisplay, Mode=OneWay}" FontSize="{Binding UiFontSizeLg}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Title, Mode=OneWay}" FontSize="{Binding UiFontSize}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedItem.Platform, Mode=OneWay, StringFormat={}Platform: {0}}" Foreground="{StaticResource MutedText}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Buyer, Mode=OneWay, StringFormat={}Buyer: {0}}" Foreground="{StaticResource MutedText}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Total" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedItem.TotalScore, Mode=OneWay}" Margin="0,0,16,0"/>
                            <TextBlock Text="Intent" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedItem.IntentScore, Mode=OneWay}" Margin="0,0,16,0"/>
                            <TextBlock Text="Gear" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedItem.GearScore, Mode=OneWay}" Margin="0,0,16,0"/>
                            <TextBlock Text="Confidence" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedItem.ConfidenceScore, Mode=OneWay}"/>
                        </StackPanel>

                        <TextBlock Text="Intent Phrases" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.MatchedIntentPhrases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Text}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Gear Matches" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.MatchedGear}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Text}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Source URLs" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.SourceUrls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding Url}">
                                            <Run Text="{Binding Label}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Body" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <TextBox Text="{Binding SelectedItem.Body, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="{StaticResource ControlBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10" MinHeight="220"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding ModeLabel}" Foreground="#94A3B8"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="240" Height="14" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
