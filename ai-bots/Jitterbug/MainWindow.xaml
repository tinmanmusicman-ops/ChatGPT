<Window x:Class="Jitterbug.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="Jitterbug Help Chat"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontSize="14">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource TitleBarAccentBrush}"
                    Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    MouseDown="TitleBar_MouseDown"
                    MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <DockPanel Margin="16,0">
                    <TextBlock Text="Jitterbug Help Chat"
                               Foreground="#F7F7F7"
                               FontWeight="SemiBold"
                               FontSize="16"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right">
                        <Button x:Name="MinimizeTitleButton"
                                Width="40" Height="28"
                                Margin="0,6,6,6"
                                Click="MinimizeTitleButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                        <Button x:Name="MaximizeTitleButton"
                                Width="40" Height="28"
                                Margin="0,6,6,6"
                                Click="MaximizeTitleButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Rectangle Stroke="#F7F7F7" StrokeThickness="2" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="CloseTitleButton"
                                Width="40" Height="28"
                                Margin="0,6,0,6"
                                Click="CloseTitleButton_Click"
                                PreviewMouseLeftButtonDown="TitleCloseButton_PreviewMouseLeftButtonDown"
                                Background="#000000"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Markdown sources"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       DockPanel.Dock="Left"/>
                            <Button x:Name="RefreshListButton"
                                    Content="Refresh"
                                    Width="90"
                                    Height="30"
                                    Margin="0,0,0,0"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>

                        <ListBox x:Name="MarkdownList"
                                 Height="240"
                                 BorderBrush="{StaticResource PanelBorderBrush}"
                                 BorderThickness="1"
                                 Background="#0B1220"
                                 Foreground="#F8FAFC"/>
                        <TextBlock x:Name="FilePathText"
                                   Text="No file selected"
                                   Foreground="#E5E7EB"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Preview" Margin="0,12,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                        <ScrollViewer Height="130"
                                      Background="#020807"
                                      BorderBrush="{StaticResource PanelBorderBrush}"
                                      BorderThickness="1">
                            <TextBlock x:Name="MarkdownSnippet"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Foreground="#D1E0D8"
                                       Margin="8"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="12"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"/>

                <Border Grid.Column="2"
                        Background="#050608"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      x:Name="ConversationScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="#030508">
                            <StackPanel x:Name="ConversationPanel" Margin="0"/>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ask a question"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="QueryTextBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="90"
                                     TextWrapping="Wrap"
                                     Background="#0B1220"
                                     Foreground="#F8FAFC"
                                     BorderBrush="{StaticResource PanelBorderBrush}"
                                     BorderThickness="1"
                                     Padding="10"/>
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button x:Name="SendButton"
                                        Content="Ask question"
                                        Width="150"
                                        Height="38"
                                        Margin="0,0,8,0"
                                        Background="{StaticResource ButtonAccentBrush}"
                                        BorderBrush="#1D4ED8"
                                        Foreground="White"/>
                                <Button x:Name="ClearButton"
                                        Content="Clear chat"
                                        Width="150"
                                        Height="38"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" Margin="18,8,18,18">
                <TextBlock x:Name="StatusText"
                           Text="Select a Markdown entry to load its text."
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
