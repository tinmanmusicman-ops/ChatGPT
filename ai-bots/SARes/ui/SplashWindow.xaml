<Window x:Class="SARes.ui.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SARes"
        Width="760"
        Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="#FF0B1220"
            CornerRadius="16"
            BorderBrush="#FF475569"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            Padding="0"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#99000000" BlurRadius="24" ShadowDepth="6"/>
        </Border.Effect>
        <Grid>
            <Image Source="/SARes;component/assets/splash/bg.png"
                   Stretch="UniformToFill"
                   SnapsToDevicePixels="True"/>
            <TextBlock Text="HSST Tailored Resume"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,32,0,0">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E3B18A" Offset="0.0"/>
                        <GradientStop Color="#9FD6CF" Offset="0.5"/>
                        <GradientStop Color="#5ED6FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
        </Grid>
    </Border>
</Window>
