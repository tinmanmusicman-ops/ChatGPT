<Window x:Class="SARes.ui.SelectResumeMarkdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="Select base resume Markdown"
        Width="620" Height="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0B111A"
            BorderBrush="#324A19"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#3d421b"
                    Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    MouseDown="TitleBar_MouseDown"
                    MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <DockPanel Margin="16,0">
                    <TextBlock Text="Select base resume Markdown"
                               Foreground="#F7F7F7"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right">
                        <Button x:Name="MinimizeTitleButton"
                                Width="40" Height="28"
                                Margin="0,6,6,6"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                        <Button x:Name="MaximizeTitleButton"
                                Width="40" Height="28"
                                Margin="0,6,6,6"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Rectangle Stroke="#F7F7F7" StrokeThickness="2" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="TitleCloseButton"
                                Width="40" Height="28"
                                Margin="0,6,0,6"
                                Background="#000000"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="0,0,16,16"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Browse for the Markdown file you'd like to store as the base template."
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <DockPanel>
                        <TextBox x:Name="FilePathTextBox"
                                 IsReadOnly="True"
                                 Height="36"
                                 FontSize="14"
                                 Background="#0B111A"
                                 BorderBrush="{StaticResource Border}"
                                 BorderThickness="1"
                                 Margin="0,0,12,0"/>
                        <Button x:Name="BrowseButton"
                                Content="Browse..."
                                Width="120"
                                Height="36"/>
                    </DockPanel>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="2" Margin="12,10,12,16">
                <TextBlock Text="You can keep the Markdown file on disk; only the contents are copied."
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Width="120" Height="38" Margin="0,0,12,0"/>
                    <Button x:Name="ImportButton"
                            Content="Import"
                            Width="150"
                            Height="38"
                            Background="#2563EB"
                            BorderBrush="#1D4ED8"
                            Foreground="White"
                            IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
