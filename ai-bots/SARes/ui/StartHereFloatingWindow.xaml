<Window x:Class="SARes.ui.StartHereFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Start Here Guide"
        Width="760" Height="900"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="#0B1220"
        Foreground="#E5E7EB">
    <Border Background="#0F1226" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Start Here Guide" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <Button x:Name="CloseButton" Content="Close" Width="90" Height="28" DockPanel.Dock="Right" Margin="6,0,0,0"/>
            </DockPanel>

            <wv2:WebView2 x:Name="StartHereWeb" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
