<Window x:Class="SARes.ui.TemplatesAndSummariesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="Templates &amp; Summaries"
        Width="860" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0B111A" BorderBrush="#324A19" BorderThickness="1" CornerRadius="16" Padding="0" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#1F3E18"
                    Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    MouseDown="TitleBar_MouseDown">
                <DockPanel Margin="14,0">
                    <TextBlock Text="Templates &amp; Summaries"
                               Foreground="#F7F7F7"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right">
                        <Button Width="40" Height="28"
                                Margin="0,6,6,6"
                                Command="{x:Static system:SystemCommands.MinimizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                        <Button Width="40" Height="28"
                                Margin="0,6,6,6"
                                Command="{x:Static system:SystemCommands.MaximizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Rectangle Stroke="#F7F7F7" StrokeThickness="2" Width="11" Height="11"/>
                        </Button>
                        <Button Width="40" Height="28"
                                Margin="0,6,0,6"
                                Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Configure the imported base resume template and saved Summary versions." FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Only Summary is editable at generation time; all other resume content stays unchanged."
                               Foreground="{StaticResource MutedText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TabControl Grid.Row="1">
                    <TabItem Header="Base Resume">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Base resume template" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <DockPanel Grid.Row="1">
                                <ComboBox x:Name="BaseTemplateComboBox" Height="34" Width="320" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                <Button x:Name="NewBaseTemplateButton" Content="New..." Width="110" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="RenameBaseTemplateButton" Content="Rename" Width="110" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="DeleteBaseTemplateButton" Content="Delete" Width="110" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="UseBundledBaseTemplateButton" Content="Use bundled" Width="110" Height="34"/>
                            </DockPanel>

                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBox x:Name="BaseTemplatePathTextBox" Height="34" IsReadOnly="True" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                <Button x:Name="EditBaseTemplateButton" Content="Edit..." Width="110" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="ImportPdfButton" Content="Import PDF..." Width="110" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="ImportMdButton" Content="Import MD..." Width="110" Height="34"/>
                            </DockPanel>

                            <TextBlock Grid.Row="3"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Tip: use Import PDF to store your resume inside the app. The app injects your Summary under the '## Summary:' section and leaves everything else unchanged."/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Summary Versions">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="Saved summaries" Foreground="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <ListBox x:Name="PresetList" Height="520"/>
                            </StackPanel>

                            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

                            <Grid Grid.Column="2" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Selected summary" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="AddPresetButton" Grid.Column="1" Content="Add" Height="30" Width="90" Margin="0,0,8,0"/>
                                <Button x:Name="RenamePresetButton" Grid.Column="2" Content="Rename" Height="30" Width="90" Margin="0,0,8,0"/>
                                <Button x:Name="DeletePresetButton" Grid.Column="3" Content="Delete" Height="30" Width="90" Margin="0,0,8,0"/>
                                <Button x:Name="EditPresetButton" Grid.Column="4" Content="Edit..." Height="30" Width="90" Margin="0,0,8,0"/>
                                <Button x:Name="LoadFromMainButton" Grid.Column="5" Content="Load from main" Height="30" Width="130"/>
                            </Grid>

                            <TextBox Grid.Column="2" Grid.Row="1" x:Name="SummaryPresetTextBox"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </TabItem>
                </TabControl>

                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock x:Name="DialogStatus" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="SaveButton" Content="Save" Width="110" Height="34" Margin="0,0,8,0"/>
                        <Button x:Name="CloseButton" Content="Close" Width="110" Height="34"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
