<Window x:Class="SARes.ui.ImportPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Import Base Resume (PDF)"
        Width="1400" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        Foreground="#E5E7EB">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IntroText"
                       Text="Step 1: tag section headers in the PDF, then Save Map."
                       Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button x:Name="SelectPdfButton" Grid.Column="1" Content="Select PDF..." Height="30" Width="120"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PdfColumn" Width="2*"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="10"/>
                <ColumnDefinition x:Name="RightColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PdfPreviewPanel" Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="PDF Preview" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <wv2:WebView2 Grid.Row="1" x:Name="PdfWeb"/>
                </Grid>
            </Border>

            <GridSplitter x:Name="PdfGridSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HeaderMappingTitle" Text="Header Mapping (check = force bullets, double-click = remove)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border x:Name="HeaderMappingListBorder" Grid.Row="1" Background="#111827" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="150">
                            <ListBox x:Name="HeaderMapListBox"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="TemplateTitle" Grid.Row="2" Text="Extracted Base Resume Text (internal template)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TemplateTextBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock x:Name="LayoutLabel" Text="Layout:" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="LayoutModeComboBox" Height="32" Width="220" Margin="0,0,8,0"/>
                        <Button x:Name="ImportButton" Content="Import" Height="32" Width="120" Margin="0,0,8,0"/>
                        <Button x:Name="ReorderSectionsButton" Content="Reorder Sections..." Height="32" Width="160" Margin="0,0,8,0"/>
                        <Button x:Name="ManageHeadersButton" Content="Manage headers..." Height="32" Width="160" Margin="0,0,8,0"/>
                        <Button x:Name="SaveMapButton" Content="Save Map" Height="32" Width="160" Margin="0,0,8,0"/>
                        <Button x:Name="SaveButton" Content="Save Template" Background="#2563EB" BorderBrush="#1D4ED8" Foreground="White" Height="32" Width="140"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="Close" Width="120" Height="34"/>
        </DockPanel>
    </Grid>
</Window>
