<Window x:Class="SARes.ui.PdfHeaderMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="PDF Header Mapping"
        Height="640"
        Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontSize="16">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border Background="#0B111A"
            BorderBrush="#324A19"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#1F3E18"
                    Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    MouseDown="TitleBar_MouseDown"
                    MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <DockPanel Margin="14,0">
                    <TextBlock Text="PDF Header Mapping"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F7F7F7"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right">
                        <Button x:Name="MinimizeTitleButton"
                                Width="40" Height="28"
                                Margin="0,6,6,6"
                                Click="MinimizeTitleButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                        <Button x:Name="MaximizeTitleButton"
                                Width="40" Height="28"
                                Margin="0,6,6,6"
                                Click="MaximizeTitleButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Rectangle Stroke="#F7F7F7" StrokeThickness="2" Width="11" Height="11"/>
                        </Button>
                        <Button x:Name="TitleCloseButton"
                                Width="40" Height="28"
                                Margin="0,6,0,6"
                                Click="CloseWindow_Click"
                                PreviewMouseLeftButtonDown="TitleCloseButton_PreviewMouseLeftButtonDown"
                                Background="#000000"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="0,0,16,16"
                    Padding="16"
                    Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Confirm or add the headers that match this resume before running the import."
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,0"
                               Text="Default headers: Summary, Core Skills, Achievements, Professional Experience, Education, Certifications"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,12,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch">
                        <TextBlock VerticalAlignment="Center" Text="Preset:"/>
                        <ComboBox x:Name="PresetComboBox"
                                  Width="320"
                                  Margin="0,0,4,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="Map name:"/>
                        <TextBox x:Name="PresetNameTextBox"
                                 Width="320"
                                 VerticalContentAlignment="Center"
                                 Margin="6,0,0,0"/>
                        <Button x:Name="SavePresetButton"
                                Content="Save map"
                                Width="140"
                                Height="44"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                    <DockPanel Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Text="Layout:" Margin="0,0,6,0"/>
                        <ComboBox x:Name="LayoutComboBox" Width="320"/>
                    </DockPanel>

                    <GroupBox Grid.Row="5"
                              Header="Header map"
                              Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="CustomHeadersListBox"
                                     Margin="0,0,0,8"
                                     SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <CheckBox IsChecked="{Binding ForceBullets}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      ToolTip="Force bullet formatting for all lines under this section header"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8">
                                <TextBox x:Name="NewHeaderTextBox"
                                         Width="320"
                                         VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="ForceBulletsCheckBox"
                                          Content="Bullets"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          ToolTip="If checked, all lines under this header will be forced to '- ' bullets on import."/>
                                <Button x:Name="AddHeaderButton" Content="Add" Width="90" Height="44" Margin="10,0,0,0"/>
                                <Button x:Name="EditHeaderButton" Content="Edit" Width="90" Height="44" Margin="10,0,0,0"/>
                                <Button x:Name="RemoveHeaderButton" Content="Remove" Width="110" Height="44" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button x:Name="MoveUpButton" Content="Move Up" Width="150" Height="44" Margin="0,0,12,0"/>
                                <Button x:Name="MoveDownButton" Content="Move Down" Width="150" Height="44"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <DockPanel Grid.Row="6" Margin="0,12,0,0">
                        <Button x:Name="ResetButton" Content="Reset" Width="120" Height="44"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="RunImportButton" Content="Run Import" Width="160" Height="44" IsDefault="True" Margin="0,0,12,0"/>
                            <Button x:Name="CancelButton" Content="Cancel" Width="120" Height="44" IsCancel="True"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
