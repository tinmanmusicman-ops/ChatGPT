<Window x:Class="SARes.ui.EditSummaryPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Summary Version"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        Foreground="#E5E7EB">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Edit saved Summary text." FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="PresetNameText" Foreground="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="8">
            <TextBox x:Name="SummaryTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save" Width="110" Height="34" Margin="0,0,8,0"
                        Background="#2563EB" BorderBrush="#1D4ED8" Foreground="White"/>
                <Button x:Name="CloseButton" Content="Close" Width="110" Height="34"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

