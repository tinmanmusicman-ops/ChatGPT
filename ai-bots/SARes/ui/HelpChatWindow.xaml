<Window x:Class="SARes.ui.HelpChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Help Chat"
        Width="920" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#151c0a"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="UserBg" Color="#111827"/>
        <SolidColorBrush x:Key="AssistantBg" Color="#0B162B"/>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0B111A"
            BorderBrush="#324A19"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#3d421b"
                    Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    MouseDown="TitleBar_MouseDown">
                <DockPanel Margin="16,0">
                    <TextBlock Text="SARes Help Chat"
                               Foreground="#F7F7F7"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right">
                        <Button Width="40" Height="28"
                                Margin="0,6,6,6"
                                Command="{x:Static system:SystemCommands.MinimizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                        <Button Width="40" Height="28"
                                Margin="0,6,6,6"
                                Command="{x:Static system:SystemCommands.MaximizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Rectangle Stroke="#F7F7F7" StrokeThickness="2" Width="11" Height="11"/>
                        </Button>
                        <Button Width="40" Height="28"
                                Margin="0,6,0,6"
                                Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent"
                                BorderBrush="Transparent">
                            <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="#F7F7F7" StrokeThickness="2"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="SARes Help" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Answers come only from the operator manual." Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="HideTagsCheckBox" Content="Hide tags" Margin="0,0,10,0" IsChecked="True"/>
                        <Button x:Name="CloseButton" Content="Close" Width="110" Height="34"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <wv2:WebView2 x:Name="ChatWeb"/>
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Row="0"
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1">
                        <TextBox x:Name="QuestionTextBox"
                                 Height="46"
                                 VerticalContentAlignment="Center"
                                 Padding="12,10"
                                 Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ClearButton" Content="Clear" Width="100" Height="36" Margin="0,0,10,0"/>
                            <Button x:Name="SendButton" Content="Send" Width="100" Height="36" Background="#2563EB" BorderBrush="#1D4ED8" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
