{
  "manifest_version": 3,
  "name": "Job Description Copier",
  "description": "Copies job descriptions from LinkedIn or Indeed with one click.",
  "version": "1.1",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Copy Job Description",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
