{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "file://C:/ChatGPT/ai-bots/Thermostats/Web/dashboard_public.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Launch Chrome (current file)",
      "type": "pwa-chrome",
      "request": "launch",
      "file": "${file}",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Current Python file",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "args": []
    },
    {
      "name": "Launch C# (.NET)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/ai-bots/DiskInsight/bin/Debug/net8.0-windows/DiskInsight.dll",
      "preLaunchTask": "build DiskInsight (Debug)",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ]
}
